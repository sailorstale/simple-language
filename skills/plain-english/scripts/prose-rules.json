{
  "_": [
    "Word lists for the plain-english check (prose-check.mjs sits next to this file).",
    "Edit by hand. Only put a word in 'formal' if its replacement is right in almost every context — that list is matched literally.",
    "'formal' — formal or long words with a safe plain replacement (strict finding).",
    "'hidden-verbs' — a verb hidden inside a noun; turn it back into the verb (strict finding).",
    "'empty-links' — link text that says nothing about the target (strict finding).",
    "'hype' — subjective marketing adjectives; shown only with --all (advisory)."
  ],

  "formal": {
    "utilise": "use",
    "utilize": "use",
    "commence": "start",
    "ascertain": "find out",
    "endeavour": "try",
    "endeavor": "try",
    "obtain": "get",
    "assist": "help",
    "demonstrate": "show",
    "sufficient": "enough",
    "approximately": "about",
    "regarding": "about",
    "with regard to": "about",
    "prior to": "before",
    "subsequent to": "after",
    "in order to": "to",
    "in the event that": "if",
    "in the majority of cases": "usually",
    "at this time": "now",
    "at present": "now"
  },

  "hidden-verbs": {
    "conduct an analysis of": "analyse",
    "make a decision": "decide",
    "provide assistance to": "help",
    "give consideration to": "consider",
    "make an assessment of": "assess",
    "carry out a review of": "review",
    "reach a conclusion": "conclude",
    "make an application": "apply",
    "is responsible for the management of": "manages"
  },

  "empty-links": [
    "here", "click here", "go here", "see here", "click", "tap here",
    "read more", "learn more", "more", "details", "this", "this one",
    "this document", "this article", "this page", "this link", "this post",
    "link", "website", "site", "url"
  ],

  "hype": [
    "brilliant", "seamless", "world-class", "cutting-edge", "cutting edge",
    "revolutionary", "amazing", "incredible", "game-changing", "game changing",
    "best-in-class", "state-of-the-art", "next-generation", "next-gen",
    "delightful", "effortless", "innovative", "unparalleled", "unrivalled",
    "blazing-fast", "supercharged"
  ]
}
